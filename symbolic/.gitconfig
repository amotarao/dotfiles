[core]
    ignorecase = false
    editor = vim

[user]
    name = Amon Sawamura
    email = amotarao@gmail.com

[color]
    ui = auto

[alias]
    st = status
    a = add
    c = commit -m
    ci = commit
    co = checkout
    amend = commit --amend

[credential "https://github.com"]
    helper =
    helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !/opt/homebrew/bin/gh auth git-credential
